{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewFlow AI Report",
  "type": "object",
  "required": [
    "risk_level",
    "status",
    "summary",
    "changed_files",
    "owner_mapping",
    "findings",
    "test_suggestions",
    "human_review_required"
  ],
  "properties": {
    "risk_level": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "PASSED",
        "WARNING",
        "FAILED"
      ]
    },
    "summary": {
      "type": "string"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owner_mapping": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "sonar_summary": {
      "type": "object"
    },
    "dependency_summary": {
      "type": "object"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "category",
          "file",
          "title",
          "evidence",
          "recommendation",
          "confidence",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "logic",
              "security",
              "quality",
              "dependency",
              "test",
              "maintainability"
            ]
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "codex",
              "sonar",
              "dependency",
              "rule"
            ]
          }
        }
      }
    },
    "test_suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "title",
          "reason"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "suggested_patch": {
      "type": [
        "string",
        "null"
      ]
    },
    "human_review_required": {
      "type": "boolean"
    }
  }
}